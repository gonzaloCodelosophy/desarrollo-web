# Entorno
NODE_ENV=development
PORT=3000

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=clinica_turnos
DB_LOGGING=false

# Autenticación (JWT)
JWT_SECRET=cambiar-por-un-secreto-seguro
JWT_EXPIRES_IN=8h

# Swagger
SWAGGER_HABILITADO=true
